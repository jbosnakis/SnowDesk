#include <winres.h>
#include "resource.h"

IDI_APP ICON "app.ico"
1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,2,0
 PRODUCTVERSION 1,1,2,0
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Perforks"
            VALUE "FileDescription", "SnowDesk desktop snow"
            VALUE "FileVersion", "1.1.2"
            VALUE "InternalName", "SnowDesk"
            VALUE "LegalCopyright", "Copyright (C) 2026 Perforks"
            VALUE "OriginalFilename", "SnowDesk.exe"
            VALUE "ProductName", "SnowDesk"
            VALUE "ProductVersion", "1.1.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
